doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      html, body {
        height: 100%;
      }
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        padding: 20px;
      }
      .email-container {
        max-width: 635px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        min-height: 600px;
      }
      .email-header {
        height: 250px;
        overflow: hidden;
        margin: 0 auto;
        display: flex;
      }
      .email-header img {
        height: 325px;
        margin: 0 auto;
      }
      .email-body h1 {
        font-size: 24px;
        color: #333;
        margin-bottom: 20px;
      }
      .email-body p {
        font-size: 16px;
        color: #333;
        line-height: 1.5;
        margin-bottom: 20px;
      }
      .email-footer {
        font-size: 12px;
        color: #777;
        text-align: center;
        margin-top: 120px;
        margin-bottom: 100px;
      }
      .email-footer a {
        color: #777;
        text-decoration: none;
      }
      .share-buttons {
        margin-top: 20px;
      }
      .share-buttons a {
        display: inline-block;
        margin-right: 10px;
        margin-bottom: 10px;
        padding: 10px 15px;
        background-color: #f0f0f0;
        color: #333;
        text-decoration: none;
        border-radius: 5px;
      }
  body
    .email-container
      .email-header
        img(src="https://interintellect.nyc3.digitaloceanspaces.com/logos/email-logo.png", alt="Interintellect")
      .email-body
        case type
          when 'edit_approved'
            p Dear #{host.name},
            p
              | Your request to edit the details of your event, 
              a(href=`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`) #{salon.title},
              |  has been approved.
            p Interintellect Team
          when 'first_salon'
            p Dear #{host.name},
            p
              | Congratulations on listing 
              a(href=`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`) #{salon.title}
              | !
            p
              | To finalize the publication process and receive payment for your events, please ensure you have completed our payment onboarding process on your 
              a(href=`${process.env.NEXTAUTH_URL}/dashboard/payments`) host payout page
              | .
            p For questions or further information, email our customer service team at haley@interintellect.com.
            p Interintellect Team
          when 'new_salon'
            h1 Your salon has been published!
            p Dear #{host.name},
            p
              | Congratulations, 
              a(href=`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`) #{salon.title}
              |  has been published!
            .share-buttons
              a(href=`https://twitter.com/intent/tweet?url=${encodeURIComponent(`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`)}`) Share on X
              a(href=`https://substack.com/publish?url=${encodeURIComponent(`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`)}`) Share on Substack
              a(href=`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`)}`) Share on Facebook
              a(href=`https://www.linkedin.com/shareArticle?url=${encodeURIComponent(`${process.env.NEXTAUTH_URL}/salons/${salon.slug}`)}`) Share on LinkedIn
            p 
              | For questions or further information, email our customer service team at 
              a(href="mailto:haley@interintellect.com") haley@interintellect.com
              | .
            p Interintellect Team
      .email-footer
        | © 2024 Pynchon Ideas.
        br
        | 2810 N Church St. PMB 59729 Wilmington, Delaware 19802